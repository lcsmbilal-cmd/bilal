# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Render automatically sets this; default is 10000 on Render)
PORT=10000

# Environment mode ('production' on Render)
NODE_ENV="production"

# Admin Authentication Secrets (Render Web Service Environment Settings)
ADMIN_JWT_SECRET="generate-a-strong-random-jwt-secret-key-for-production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourSecureAdminPassword2025!"
ADMIN_EMAIL="admin@ammiexpress.pk"
